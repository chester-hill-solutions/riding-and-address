{
  "name": "riding-lookup-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging bun run build && wrangler deploy",
    "typecheck": "react-router typegen && tsc -b",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply PORTAL_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply PORTAL_DB --remote",
    "db:migrate:staging": "wrangler d1 migrations apply PORTAL_DB --env staging --remote",
    "test:runtime": "node scripts/test-runtime.mjs"
  },
  "packageManager": "bun@1.4.3",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@chester-hill-solutions/auth": "file:./vendor/@chester-hill-solutions/auth",
    "@chester-hill-solutions/auth-d1": "file:./vendor/@chester-hill-solutions/auth-d1",
    "@chester-hill-solutions/auth-react-router": "file:./vendor/@chester-hill-solutions/auth-react-router",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "^5.1.28",
    "lucide-react": "^1.25.0",
    "react": "^19.2.9",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.2.9",
    "react-router": "^8.4.0",
    "stripe": "^18.0.0",
    "tailwind-merge": "^3.6.0",
    "@chester-hill-solutions/validation": "file:../vendor/@chester-hill-solutions/validation",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.45.0",
    "@cloudflare/workers-types": "^5.20261018.1",
    "@react-router/dev": "^8.4.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4",
    "typescript": "^5.8.0",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.105.0"
  },
  "overrides": {
    "undici": "^7.29.1",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "nanoid": "^3.3.18",
    "browserslist": "^4.29.3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
