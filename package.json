{
  "name": "ridinglookup",
  "version": "1.0.0",
  "description": "CanCoder: Canadian address geocoding, autocomplete, and electoral district API on Cloudflare Workers.",
  "main": "index.js",
  "dependencies": {
    "@chester-hill-solutions/http": "file:./vendor/@chester-hill-solutions/http",
    "@chester-hill-solutions/validation": "file:./vendor/@chester-hill-solutions/validation",
    "@modelcontextprotocol/server": "2.3.1",
    "brace-expansion": "^5.0.12",
    "jose": "^6.2.12",
    "nanoid": "^6.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/oauth-provider": "^1.7.10",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^10.0.1",
    "@scalar/api-reference": "^1.74.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "better-auth": "^1.7.10",
    "eslint": "10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "scripts": {
    "dev": "bun run --cwd portal dev",
    "deploy": "bun run --cwd portal deploy",
    "deploy:staging": "bun run --cwd portal deploy:staging",
    "build": "bun run typecheck && bun install --cwd portal --frozen-lockfile && bun run --cwd portal build && bun scripts/write-deploy-redirect.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.dom.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" \"portal/app/**/*.{ts,tsx}\" \"portal/test/**/*.ts\" \"portal/workers/**/*.ts\" \"portal/*.ts\" --max-warnings 0",
    "lint:fix": "eslint src/**/*.ts test/**/*.ts scripts/**/*.ts --fix --max-warnings 0",
    "validate": "bun run lint && bun run typecheck && bun run check:billing-invariants && bun run test",
    "check:billing-invariants": "bun scripts/check-billing-invariants.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:oda": "vitest run test/oda-normalize.test.ts test/oda-geocoding.test.ts test/oda-fixture-cases.test.ts test/oda-config.test.ts test/canada-post-format.test.ts",
    "test:oda:live": "ODA_LIVE=1 vitest run test/oda-geocoding-live.test.ts",
    "benchmark:lookup": "tsx scripts/benchmark-lookup.ts",
    "verify:x402": "tsx scripts/verify-x402-facilitator.ts",
    "compare:opennorth": "tsx scripts/compare-opennorth.ts",
    "compare:report": "tsx scripts/generate-comparison-report.ts",
    "upload:r2-datasets": "tsx scripts/upload-r2-datasets.ts",
    "acquire:provincial-ridings": "python3 scripts/acquire-provincial-ridings.py",
    "import:oda:all": "tsx scripts/import-oda.ts --download --provinces ALL --remote --skip-schema --resume",
    "import:oda:centroids": "bash scripts/rebuild-oda-centroids.sh",
    "import:oda": "tsx scripts/import-oda.ts",
    "import:nar": "tsx scripts/import-nar.ts",
    "import:nar:plan": "tsx scripts/plan-nar-fsa.ts",
    "import:nar:next": "tsx scripts/import-nar.ts --next --remote",
    "build:oda:suggest": "tsx scripts/build-oda-suggest.ts",
    "keys": "tsx scripts/manage-keys.ts",
    "prepare": "husky"
  },
  "packageManager": "bun@1.4.3",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "overrides": {
    "sharp": "^0.35.5",
    "nanoid": "^6.0.2",
    "brace-expansion": "^5.0.12",
    "postcss": "^8.5.26",
    "source-map-js": "^1.2.2",
    "vue": "^3.5.44"
  }
}
